# GEMINI_API_KEY: Required for optional AI message translation and conversation summarization.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where Tolk by Lunola is hosted (Wasmer Edge / Docker / Cloud Run).
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side passcode to unlock the Tolk by Lunola Admin Panel.
# DEFAULT_ADMIN_*: Optional overrides for the seeded default Super Admin account.
ADMIN_PASSCODE=
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Managed SQL Database (auto-injected by Wasmer Edge Database at runtime)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
# Optional: mysql | postgres (auto-detected if empty)
DB_ENGINE=
# Optional: false | true | auto (default connects without SSL first)
DB_SSL=false

# Public access & platform limits
ALLOW_GUEST=false
PORT=3000
MAX_UPLOAD_MB=10
RATE_LIMIT_PER_MIN=120
TINODE_HOST="ws://tinode:6060/v0/channels"

